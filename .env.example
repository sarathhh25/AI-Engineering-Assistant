# ============================================================
# AI Engineering Copilot - Environment Configuration
# Copy this file to .env or .env.local and populate your secrets
# ============================================================

# Database Connection (PostgreSQL or SQLite)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_engineering_db

# Gemini AI API Key (Get from: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Official GitHub OAuth Application Credentials
# Register at: GitHub.com -> Settings -> Developer settings -> OAuth Apps
# Authorization callback URL: http://localhost:8000/api/integrations/github/callback
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
GITHUB_REDIRECT_URI=http://localhost:8000/api/integrations/github/callback

# Server-Side Token Encryption Key (for encrypting stored GitHub OAuth tokens)
# Generate with: openssl rand -base64 32
APP_ENCRYPTION_KEY=your_32_byte_base64_encryption_key_here

# Optional Fallback GitHub Personal Access Token (for local headless testing)
GITHUB_TOKEN=your_github_personal_access_token_here

# Frontend API Connection URL (Publicly accessible URL to Backend)
NEXT_PUBLIC_API_URL=http://localhost:8000

# NextAuth / Auth.js Authentication Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret_here_openssl_rand_base64_32
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Server Ports (Optional overrides)
PORT=3000
NODE_ENV=development
