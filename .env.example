# ============================================================
# AI Engineering Copilot - Environment Configuration
# Copy this file to .env or .env.local and populate your secrets
# ============================================================

# Gemini AI API Key (Get from: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# GitHub Personal Access Token (for repository telemetry & PR inspection)
GITHUB_TOKEN=your_github_personal_access_token_here

# Frontend API Connection URL (Publicly accessible URL to Backend)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Server Ports (Optional overrides)
PORT=3000
NODE_ENV=production
